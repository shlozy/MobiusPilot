# Copy this file to .env and fill in real values. Never commit .env.

# --- LLM (OpenAI-compatible; Groq) ---
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your-groq-api-key-here
LLM_MODEL=llama-3.3-70b-versatile
LLM_TIMEOUT_SECONDS=30

# --- Messaging ---
# google_chat | telegram | simulator   (simulator is for tests only and is labelled SIMULATED)
MESSAGING_PLATFORM=google_chat

# Google Chat (needs a Business/Enterprise Google Workspace account)
GOOGLE_APPLICATION_CREDENTIALS=secrets\service-account.json
GOOGLE_PROJECT_ID=your-gcp-project-id
GOOGLE_PUBSUB_SUBSCRIPTION_ID=your-subscription-id

# Telegram (only if the team approves replacing Google Chat)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=

# --- Agent ---
MAX_ITERATIONS=6
DB_PATH=mobiuspilot.db
